  "query": "\n        SELECT artifact_id AS \"artifact_id: ArtifactId\",\n               artifact_type,\n               title,\n               server_name,\n               context_id AS \"context_id: ContextId\",\n               data,\n               created_at\n        FROM mcp_artifacts\n        WHERE artifact_id = $1\n          AND user_id = $2\n          AND (expires_at IS NULL OR expires_at > NOW())\n        ",

{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id AS \"user_id!\",\n            a.status,\n            EXISTS(SELECT 1 FROM webauthn_credentials c WHERE c.user_id = u.id)\n                AS \"has_credential!\"\n        FROM users u\n        LEFT JOIN user_approvals a ON a.user_id = u.id\n        WHERE u.email = $1\n        ",

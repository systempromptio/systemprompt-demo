  "query": "\n        SELECT kind as \"kind!\", body->>'text' as \"text!\", at as \"at!\"\n        FROM pi_conversation_events\n        WHERE conversation_id = $1\n          AND kind IN ('user_message', 'text_delta')\n          AND body->>'text' IS NOT NULL\n        ORDER BY seq\n        LIMIT $2\n        ",

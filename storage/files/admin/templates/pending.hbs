<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} - Account Under Review</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
    <script>(function(){document.documentElement.style.colorScheme='light';})();</script>
    <style>
        html,body{margin:0;background:var(--sp-bg-base);color:var(--sp-text-primary);font-family:"OpenSans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
        .login-logo .logo-light{display:block !important}
        .login-logo .logo-dark{display:none !important}
        .login-container .card{background:var(--sp-bg-surface) !important;backdrop-filter:none !important;border:1px solid var(--sp-border-subtle) !important}
        .card{background:linear-gradient(180deg,var(--sp-bg-surface) 0%,var(--sp-bg-canvas) 60%,var(--sp-bg-base) 100%) !important}
    </style>
</head>
<body>
    <div class="login-container">
        <div class="card">
            <div class="login-logo">
                <img src="/files/images/logo.svg" alt="{{branding.domain}}" height="40" class="logo-light">
                <img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="40" class="logo-dark">
            </div>
            <p class="login-subtitle">Account under review</p>

            <div class="text-center p-4">
                <p class="text-base text-primary mb-2">Thanks for registering{{#if display_name}}, {{display_name}}{{/if}}</p>
                <p class="text-sm text-tertiary mb-4">
                    We review every account by hand before granting access. Someone
                    is looking at the details you gave for
                    {{#if company}}<strong>{{company}}</strong>{{else}}your company{{/if}} now.
                </p>
                <p class="text-sm text-tertiary mb-4">
                    You'll get an email at <strong>{{email}}</strong> the moment your
                    account is approved, with your evaluation credit ready to use.
                    Nothing else is needed from you.
                </p>
                <p class="text-sm text-tertiary mb-4">
                    Something we should know, or been waiting too long?
                    Reply to that email or contact <a href="mailto:{{support_email}}">{{support_email}}</a>.
                </p>
            </div>

            <p class="text-center mt-4 text-tertiary text-sm">
                <a href="/admin/logout">Sign out</a>
            </p>
        </div>
    </div>
</body>
</html>

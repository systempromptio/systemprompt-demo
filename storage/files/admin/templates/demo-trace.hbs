<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} - Audit Trail</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
</head>
<body class="trace-page">
    <main class="trace-shell">
        <header class="trace-head">
            <p class="trace-eyebrow">{{branding.domain}} · governance spine</p>
            <div class="trace-title-row">
                <h1>Audit trail</h1>
                <div class="trace-actions">
                    <button type="button" class="trace-action" id="trace-print" aria-label="Print this audit trail">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                        <span>print</span>
                    </button>
                    <button type="button" class="trace-action" id="trace-share" aria-label="Share a link to this audit trail">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 10.6 6.8-4.2M8.6 13.4l6.8 4.2"/></svg>
                        <span>share</span>
                    </button>
                </div>
            </div>
            {{#if has_session}}
            <dl class="trace-identity">
                <div><dt>operator</dt><dd>{{username}}</dd></div>
                <div><dt>conversation</dt><dd><code>{{conversation_id}}</code></dd></div>
                <div><dt>attested session</dt><dd><code>{{session_id}}</code></dd></div>
                {{#if conversation_title}}<div><dt>title</dt><dd>{{conversation_title}}</dd></div>{{/if}}
            </dl>
            {{/if}}
        </header>

        {{#if has_session}}
        <section class="trace-attestation" aria-label="Integrity attestation">
            <span class="trace-attestation-label">integrity · sha-256</span>
            <code class="trace-attestation-hash">{{integrity_hash}}</code>
            <p class="trace-attestation-note">Computed over the transcript and every governed
            event below, keyed to attested session <code>{{session_id}}</code>. Re-hash the
            page's data and a changed digest means changed evidence.</p>
        </section>

        <section class="trace-summary" aria-label="Session summary">
            <div class="trace-stat"><b>{{summary.events}}</b><span>events</span></div>
            <div class="trace-stat" {{#if summary.denials}}data-hot="1"{{/if}}><b>{{summary.denials}}</b><span>denied</span></div>
            <div class="trace-stat"><b>{{summary.requests}}</b><span>AI requests</span></div>
            <div class="trace-stat"><b>{{summary.input_tokens}}</b><span>tokens in</span></div>
            <div class="trace-stat"><b>{{summary.output_tokens}}</b><span>tokens out</span></div>
            <div class="trace-stat"><b>{{summary.cost_display}}</b><span>cost</span></div>
        </section>

        {{#if has_messages}}
        <section class="trace-conversation" aria-label="Conversation transcript">
            <h2 class="trace-section-title">Conversation</h2>
            {{#each messages}}
            <article class="trace-message" data-role="{{role}}">
                <header class="trace-message-head">
                    <span class="trace-message-role">{{role}}</span>
                    <time class="trace-at">{{at}}</time>
                </header>
                <p class="trace-message-text">{{text}}</p>
            </article>
            {{/each}}
        </section>
        {{/if}}

        {{#if has_artifacts}}
        <section class="trace-artifacts" aria-label="Artifacts this session produced">
            <h2 class="trace-section-title">Artifacts</h2>
            <table class="trace-stages">
                <thead>
                    <tr><th>title</th><th>type</th><th>tool</th><th>created</th><th>view</th></tr>
                </thead>
                <tbody>
                    {{#each artifacts}}
                    <tr>
                        <td>{{title}}</td>
                        <td>{{artifact_type}}</td>
                        <td class="trace-stage-policy">{{server_name}}</td>
                        <td class="trace-stage-ms">{{at}}</td>
                        <td><a href="{{ui_href}}" target="_blank" rel="noopener">open →</a></td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </section>
        {{/if}}

        <section class="trace-timeline" aria-label="Time-ordered trace">
            {{#each events}}
            <article class="trace-event{{#if is_denied}} is-denied{{/if}}"
                     id="call-{{id}}" data-kind="{{kind}}">
                <header class="trace-event-head">
                    <span class="trace-kind">{{kind}}</span>
                    <strong class="trace-subject">{{subject}}</strong>
                    <span class="trace-outcome" data-outcome="{{outcome}}">{{outcome}}</span>
                    {{#if policy}}<span class="trace-policy">{{policy}}</span>{{/if}}
                    <time class="trace-at">{{at}}</time>
                </header>
                {{#if detail}}<p class="trace-detail">{{detail}}</p>{{/if}}
                {{#if approver}}
                <p class="trace-approver" data-action="{{approver.action}}">
                    <span class="trace-approver-avatar" aria-hidden="true">{{initials approver.name}}</span>
                    <strong>{{approver.name}}</strong> {{approver.action}} this call
                    {{#if approver.at}}at <time class="trace-at">{{approver.at}}</time>{{/if}}
                    <code class="trace-approver-id">{{approver.user_id}}</code>
                </p>
                {{/if}}
                {{#if has_stages}}
                <table class="trace-stages">
                    <thead>
                        <tr><th>policy</th><th>result</th><th>duration</th><th>detail</th></tr>
                    </thead>
                    <tbody>
                        {{#each stages}}
                        <tr data-result="{{result}}">
                            <td class="trace-stage-policy">{{policy}}</td>
                            <td class="trace-stage-result">{{result}}</td>
                            <td class="trace-stage-ms">{{duration}}</td>
                            <td class="trace-stage-detail">{{detail}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
                {{/if}}
            </article>
            {{else}}
            <p class="trace-empty">No governed activity has been recorded for this session yet.</p>
            {{/each}}
        </section>
        {{else}}
        <section class="trace-empty-state">
            <p>Nothing to show for this link. Open the audit trail from the
            terminal's <strong>audit&nbsp;→</strong> link — its address is
            <code>/trace/&lt;conversation-id&gt;</code>.</p>
        </section>
        {{/if}}
    </main>
    <script>
        (function () {
            var print = document.getElementById('trace-print');
            if (print) print.addEventListener('click', function () { window.print(); });

            var share = document.getElementById('trace-share');
            if (share) share.addEventListener('click', function () {
                var url = window.location.href;
                if (navigator.share) {
                    navigator.share({ title: document.title, url: url }).catch(function () {});
                    return;
                }
                navigator.clipboard.writeText(url).then(function () {
                    var label = share.querySelector('span');
                    var was = label.textContent;
                    share.classList.add('is-copied');
                    label.textContent = 'link copied';
                    setTimeout(function () {
                        share.classList.remove('is-copied');
                        label.textContent = was;
                    }, 2000);
                });
            });
        })();
    </script>
</body>
</html>

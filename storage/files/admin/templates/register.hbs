<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} — Create your account</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
    <script>(function(){document.documentElement.style.colorScheme='light';})();</script>
    <style>
        html,body{margin:0;background:var(--sp-bg-base);color:var(--sp-text-primary);font-family:"OpenSans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
        .auth-shell{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:2rem 1.25rem;background:radial-gradient(ellipse at 30% 20%,color-mix(in oklch,var(--sp-accent) 7%,transparent) 0%,transparent 55%),radial-gradient(ellipse at 70% 80%,color-mix(in oklch,var(--sp-section-plugins) 5%,transparent) 0%,transparent 55%),linear-gradient(180deg,var(--sp-bg-canvas) 0%,var(--sp-bg-base) 100%)}
        .auth-card{width:100%;max-width:400px}
        .auth-card .card{background:var(--sp-bg-surface) !important;border:1px solid var(--sp-border-subtle) !important;backdrop-filter:none !important;padding:2.25rem 2rem}
        .auth-logo{display:flex;justify-content:center;margin-bottom:0.5rem}
        .auth-logo .logo-dark{display:none}
        .auth-title{text-align:center;font-size:1.35rem;font-weight:700;margin:0.75rem 0 0.25rem}
        .auth-subtitle{text-align:center;font-size:0.9rem;color:var(--sp-text-secondary);margin:0 0 1.5rem}
        .auth-hint{display:flex;align-items:center;gap:0.45rem;justify-content:center;font-size:0.78rem;color:var(--sp-text-tertiary);margin-top:1.25rem}
        .auth-foot{text-align:center;margin-top:1.5rem;font-size:0.85rem;color:var(--sp-text-tertiary)}
    </style>
</head>
<body>
    <main class="auth-shell">
        <div class="auth-card">
            <div class="card">
                <div class="auth-logo login-logo">
                    <img src="/files/images/logo.svg" alt="{{branding.domain}}" height="36" class="logo-light">
                    <img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="36" class="logo-dark">
                </div>
                <h1 class="auth-title">Create your account</h1>
                <p class="auth-subtitle">Your $1 of evaluation credit is ready. Tell us who you are and what you want to look at.</p>

                <div id="error" class="login-error" role="alert" aria-live="polite"></div>

                <form id="register-form">
                    <div class="form-group">
                        <label for="reg-name">Full name</label>
                        <input class="form-input" type="text" id="reg-name" placeholder="Jane Smith" required autocomplete="name">
                    </div>
                    <div class="form-group">
                        <label for="reg-email">Work email</label>
                        <input class="form-input" type="email" id="reg-email" placeholder="you@company.com" required autocomplete="email" aria-describedby="error">
                    </div>
                    <div class="form-group">
                        <label for="reg-company">Company</label>
                        <input class="form-input" type="text" id="reg-company" placeholder="Acme Ltd" required autocomplete="organization">
                    </div>
                    <div class="form-group">
                        <label for="reg-role">Your role</label>
                        <input class="form-input" type="text" id="reg-role" placeholder="Staff Engineer" required autocomplete="organization-title">
                    </div>
                    <div class="form-group">
                        <label for="reg-team-size">Engineering team size</label>
                        <select class="form-input" id="reg-team-size" required>
                            <option value="">Select…</option>
                            <option value="1-10">1-10</option>
                            <option value="11-30">11-30</option>
                            <option value="31-100">31-100</option>
                            <option value="100+">100+</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="reg-why">What are you evaluating systemprompt for?</label>
                        <textarea class="form-input" id="reg-why" rows="3" placeholder="Governing Claude Code across our platform team, with an audit trail for SOC 2." required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="reg-credit-plans">How would you spend the evaluation credit? <span class="text-tertiary">(optional)</span></label>
                        <textarea class="form-input" id="reg-credit-plans" rows="2" placeholder="Run our existing agent workloads through the gateway for a week."></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary w-full">Continue with passkey</button>
                    </div>
                </form>

                <div id="loading" class="login-loading" hidden aria-live="polite">
                    <div class="login-spinner" role="status" aria-label="Loading"></div>
                    <p id="loading-text">Setting up your account…</p>
                </div>

                <div id="retry" class="login-retry" hidden>
                    <a href="/admin/register">Try again</a>
                </div>

                <p class="auth-hint">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Passwordless sign-in, secured by your device
                </p>

                <p class="auth-foot">
                    Already have an account? <a href="/admin/login" class="text-accent" id="login-link">Sign in</a>
                    <script>(function(){var l=document.getElementById('login-link');if(window.location.search){l.href='/admin/login'+window.location.search;}})();</script>
                </p>
            </div>
        </div>
    </main>

    <script type="module">
        import {
            makeRequest, preparePublicKeyCredentialCreationOptions,
            preparePublicKeyCredentialRequestOptions,
        } from '/js/services/webauthn-utils.js';
        import {
            buildAuthCredentialPayload, buildCreationCredentialPayload,
            initPkceAndRedirect, WEBAUTHN_BASE,
        } from '/js/services/webauthn-passkey-helpers.js';

        const LOGIN_PATH = '/admin/login';
        const POST_REGISTER = '/admin/continue';

        const form = document.getElementById('register-form');
        const errorDiv = document.getElementById('error');
        const loadingSection = document.getElementById('loading');
        const loadingText = document.getElementById('loading-text');
        const retrySection = document.getElementById('retry');

        function showError(msg) {
            errorDiv.textContent = msg;
            errorDiv.style.display = 'block';
            loadingSection.style.display = 'none';
            form.style.display = 'block';
            retrySection.style.display = 'block';
        }

        function showLoading(msg) {
            loadingText.textContent = msg || 'Setting up your account…';
            form.style.display = 'none';
            errorDiv.style.display = 'none';
            loadingSection.style.display = 'block';
        }

        if (!window.PublicKeyCredential) {
            errorDiv.textContent = 'Your browser does not support passkeys. Please use a modern browser (Chrome, Firefox, Safari, Edge).';
            errorDiv.style.display = 'block';
            form.querySelector('button[type="submit"]').disabled = true;
        }

        async function autoLogin(email) {
            try {
                showLoading('Signing you in…');
                const startResponse = await makeRequest(
                    WEBAUTHN_BASE + '/auth/start?email=' + encodeURIComponent(email), 'POST'
                );
                const publicKeyOptions = preparePublicKeyCredentialRequestOptions(startResponse.data.publicKey);
                const credential = await navigator.credentials.get({ publicKey: publicKeyOptions });
                if (!credential) throw new Error('Authentication was cancelled');
                showLoading('Verifying…');
                const finishResponse = await makeRequest(WEBAUTHN_BASE + '/auth/finish', 'POST', {
                    challenge_id: startResponse.data.challenge_id,
                    credential: buildAuthCredentialPayload(credential),
                });
                await initPkceAndRedirect(
                    finishResponse.data.user_id,
                    finishResponse.data.auth_token,
                    showLoading,
                    POST_REGISTER,
                );
            } catch (_error) {
                showLoading('Passkey created! Redirecting to sign in…');
                setTimeout(function() { window.location.href = LOGIN_PATH; }, 2000);
            }
        }

        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            const value = (id) => document.getElementById(id).value.trim();
            const email = value('reg-email');
            const displayName = value('reg-name');
            const payload = {
                name: displayName,
                email: email,
                company: value('reg-company'),
                role: value('reg-role'),
                team_size: value('reg-team-size'),
                why_assessing: value('reg-why'),
                credit_plans: value('reg-credit-plans'),
            };

            if (!email || !displayName || !payload.company || !payload.role || !payload.team_size || !payload.why_assessing) {
                showError('Please complete every field above.');
                return;
            }

            try {
                showLoading('Submitting your request…');

                const regResponse = await fetch('/admin/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                const regData = await regResponse.json();
                if (!regResponse.ok) {
                    throw new Error(regData.error || regData.message || 'Registration failed');
                }

                // This email already owns an account, so there is no passkey to
                // create — send them to sign in with the one they have.
                if (regData.already_registered) {
                    showLoading('That email is already registered. Taking you to sign in…');
                    setTimeout(function() { window.location.href = LOGIN_PATH; }, 2000);
                    return;
                }

                showLoading('Creating your passkey…');

                const setupToken = regData.token;
                const startResponse = await makeRequest(
                    WEBAUTHN_BASE + '/link/start?token=' + encodeURIComponent(setupToken),
                    'GET'
                );

                const publicKeyOptions = preparePublicKeyCredentialCreationOptions(
                    startResponse.data.challenge ? startResponse.data.challenge.publicKey : startResponse.data.publicKey
                );
                const credential = await navigator.credentials.create({ publicKey: publicKeyOptions });

                if (!credential) {
                    throw new Error('Passkey creation was cancelled');
                }

                showLoading('Finishing registration…');

                await makeRequest(WEBAUTHN_BASE + '/link/finish', 'POST', {
                    challenge_id: startResponse.data.challenge_id || startResponse.challengeId,
                    token: setupToken,
                    credential: buildCreationCredentialPayload(credential),
                });

                await autoLogin(email);

            } catch (error) {
                if (error.name === 'NotAllowedError') {
                    showError('Passkey creation was cancelled or not allowed.');
                } else if (error.name === 'NotSupportedError') {
                    showError('Passkeys are not supported on this device.');
                } else {
                    showError(error.message || 'Registration failed. Please try again.');
                }
            }
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>{{branding.domain}} — Sign in</title>
    <link rel="stylesheet" href="/css/core/fonts.css?v={{css_version}}">
    <link rel="stylesheet" href="/css/admin-bundle.css?v={{css_version}}">
    <script>(function(){document.documentElement.style.colorScheme='light';})();</script>
    <style>
        html,body{margin:0;background:var(--sp-bg-base);color:var(--sp-text-primary);font-family:"OpenSans",-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
        .auth-shell{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:2rem 1.25rem;background:radial-gradient(ellipse at 30% 20%,color-mix(in oklch,var(--sp-accent) 7%,transparent) 0%,transparent 55%),radial-gradient(ellipse at 70% 80%,color-mix(in oklch,var(--sp-section-plugins) 5%,transparent) 0%,transparent 55%),linear-gradient(180deg,var(--sp-bg-canvas) 0%,var(--sp-bg-base) 100%)}
        .auth-card{width:100%;max-width:400px}
        .auth-card .card{background:var(--sp-bg-surface) !important;border:1px solid var(--sp-border-subtle) !important;backdrop-filter:none !important;padding:2.25rem 2rem}
        .auth-logo{display:flex;justify-content:center;margin-bottom:0.5rem}
        .auth-logo .logo-dark{display:none}
        .auth-title{text-align:center;font-size:1.35rem;font-weight:700;margin:0.75rem 0 0.25rem}
        .auth-subtitle{text-align:center;font-size:0.9rem;color:var(--sp-text-secondary);margin:0 0 1.5rem}
        .auth-hint{display:flex;align-items:center;gap:0.45rem;justify-content:center;font-size:0.78rem;color:var(--sp-text-tertiary);margin-top:1.25rem}
        .auth-foot{text-align:center;margin-top:1.5rem;font-size:0.85rem;color:var(--sp-text-tertiary)}
    </style>
</head>
<body>
    <main class="auth-shell">
        <div class="auth-card">
            <div class="card">
                <div class="auth-logo login-logo">
                    <img src="/files/images/logo.svg" alt="{{branding.domain}}" height="36" class="logo-light">
                    <img src="/files/images/logo-white.svg" alt="{{branding.domain}}" height="36" class="logo-dark">
                </div>
                <h1 class="auth-title">Welcome back</h1>
                <p class="auth-subtitle">Sign in with your passkey.</p>

                <div id="error" class="login-error" role="alert" aria-live="polite"></div>

                <div id="login-form" hidden>
                    <div class="form-group">
                        <label for="login-email">Email</label>
                        <input class="form-input" type="email" id="login-email" placeholder="you@company.com" required autocomplete="email" aria-describedby="error">
                    </div>
                    <div class="form-actions">
                        <button type="button" id="sign-in-btn" class="btn btn-primary w-full">Sign in with passkey</button>
                    </div>
                    <p class="text-center mt-3 text-sm">
                        <a href="#" id="magic-link-trigger" class="text-tertiary">Lost your passkey?</a>
                    </p>
                </div>

                <div id="magic-link-form" hidden>
                    <p class="text-sm text-tertiary mb-3 text-center">
                        Enter your email and we'll send you a link to create a passkey on this device.
                    </p>
                    <div class="form-group">
                        <label for="magic-email">Email</label>
                        <input class="form-input" type="email" id="magic-email" placeholder="you@company.com" required autocomplete="email">
                    </div>
                    <div class="form-actions">
                        <button type="button" id="send-magic-btn" class="btn btn-primary w-full">Send recovery link</button>
                    </div>
                    <p class="text-center mt-2">
                        <a href="#" id="back-to-passkey" class="text-tertiary text-sm">Back to passkey sign in</a>
                    </p>
                </div>

                <div id="magic-link-sent" class="text-center p-4" hidden>
                    <p class="text-base text-primary mb-2">Check your email</p>
                    <p class="text-sm text-tertiary">
                        If an account exists for that email, we've sent a link to create a passkey on this device.
                    </p>
                    <p class="mt-3">
                        <a href="/admin/login" class="text-tertiary text-sm">Back to sign in</a>
                    </p>
                </div>

                <div id="loading" class="login-loading" hidden aria-live="polite">
                    <div class="login-spinner" role="status" aria-label="Loading"></div>
                    <p id="loading-text">Processing…</p>
                </div>

                <div id="retry" class="login-retry">
                    <a href="/admin/login">Try again</a>
                </div>

                <p class="auth-hint">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    Passwordless sign-in, secured by your device
                </p>

                <p class="auth-foot">
                    New here? <a href="/admin/register" class="text-accent" id="register-link">Create an account</a>
                    <script>(function(){var l=document.getElementById('register-link');if(window.location.search){l.href='/admin/register'+window.location.search;}})();</script>
                </p>
            </div>
        </div>
    </main>

    <script data-cfasync="false" src="/js/services/webauthn-login.js?v=2" type="module"></script>
</body>
</html>

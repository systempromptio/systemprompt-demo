  "query": "SELECT created_at as \"at!\", tool_name as \"tool_name!\",\n                  decision as \"decision!\",\n                  COALESCE(NULLIF(policy, ''), 'default_included') as \"policy!\",\n                  COALESCE(reason, '') as \"reason!\"\n           FROM governance_decisions\n           WHERE user_id = $1\n           ORDER BY created_at DESC\n           LIMIT $2",

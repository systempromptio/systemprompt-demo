  "query": "SELECT d.tool_name AS \"tool_name!\", COUNT(*)::bigint AS \"denials!\"\n           FROM governance_decisions d\n           WHERE d.created_at >= $1 AND d.decision = 'deny' AND d.tool_name <> ''\n           GROUP BY d.tool_name\n           ORDER BY COUNT(*) DESC\n           LIMIT $2",

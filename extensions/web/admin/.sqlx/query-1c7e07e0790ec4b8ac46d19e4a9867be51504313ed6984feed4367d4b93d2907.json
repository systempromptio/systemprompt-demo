{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.roles,\n            COALESCE(upe.department, 'Default') AS \"department!\",\n            COALESCE(ua.status = 'approved', false) AS \"is_approved!\"\n        FROM users u\n        LEFT JOIN user_profile_ext upe ON upe.user_id = u.id\n        LEFT JOIN user_approvals ua ON ua.user_id = u.id\n        WHERE u.id = $1\n        ",
